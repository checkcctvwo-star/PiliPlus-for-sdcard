# Remember to never publicly share a *release* keystore.
# See https://flutter.dev/docs/deployment/android#reference-the-keystore-from-the-app
key.properties
**/*.keystore
**/*.jks

# 例外：团队共享的 debug 签名必须提交，否则每次 CI 产出都要卸载重装真机。
# 这是自签名测试证书，不含发布密钥，仅用于 debug/测试构建。
!key.properties
!debug-piliplus.keystore

